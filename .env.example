# Supabase Configuration
# Found in your Supabase project settings -> API
SUPABASE_URL=dfz
# Use the service_role key for secure backend database operations:
SUPABASE_SERVICE_ROLE_KEY=zfzzd
# Alternatively, anon key (ensure workflow_submissions allows INSERT via RLS if using anon key):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Email Notification Configuration (Resend)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=SDD
# The email address where workflow assessment notifications should be sent
NOTIFICATION_EMAIL=sdD
# Optional: Sender email (defaults to "Flowzen <onboarding@resend.dev>")
NOTIFICATION_FROM_EMAIL=Flowzen Assessment <onboarding@resend.dev>
